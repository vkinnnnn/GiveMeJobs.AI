						"afrikaans",
						"georgian",
						"belarusian",
						"sindhi",
						"gujarati",
						"amharic",
						"yiddish",
						"lao",
						"uzbek",
						"faroese",
						"haitian creole",
						"pashto",
						"turkmen",
						"nynorsk",
						"marathi",
						"luxembourgish",
						"myanmar",
