{
	"name": "cursorforspeech",
	"displayName": "Cursor for Speech - Voice to Text",
	"description": "🎤 Advanced voice-to-text panel with Web Speech API and OpenAI Whisper support. Requires OpenAI API key for premium Whisper transcription. Created by Vrishn Viswa Sathyamoorthy.",
	"version": "3.6.0",
	"publisher": "VrishnViswaSathyamoorthy",
	"author": {
		"name": "Vrishn Viswa Sathyamoorthy",
		"email": "vrishnviswasathyamoorthy@gmail.com",
		"url": "https://github.com/KingReaper96420/cursorforspeech",
		"phone": "+1 9148795242"
	},
	"license": "MIT",
	"homepage": "https://github.com/KingReaper96420/cursorforspeech",
	"repository": {
		"type": "git",
		"url": "https://github.com/KingReaper96420/cursorforspeech.git"
	},
	"bugs": {
		"url": "https://github.com/KingReaper96420/cursorforspeech/issues"
	},
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other",
		"Machine Learning"
	],
	"keywords": [
		"voice",
		"speech",
		"transcription",
		"whisper",
		"openai",
		"ai",
		"cursor",
		"voice-to-text",
		"speech-recognition",
		"dictation",
		"microphone",
		"audio",
		"real-time",
		"web-speech-api",
		"productivity",
		"accessibility"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "cursorforspeech.toggleRecording",
				"title": "Toggle Voice Recording",
				"icon": "$(mic)",
				"category": "Cursor for Speech"
			},
			{
				"command": "cursorforspeech.openVoicePanel",
				"title": "Open Voice Panel",
				"icon": "$(mic)",
				"category": "Cursor for Speech"
			},
			{
				"command": "cursorforspeech.sendSelectionToChat",
				"title": "Send Selection to Cursor Chat",
				"category": "Cursor for Speech"
			},
			{
				"command": "cursorforspeech.selectLanguage",
				"title": "Select Voice Recognition Language",
				"category": "Cursor for Speech"
			}
		],
		"keybindings": [
			{
				"command": "cursorforspeech.toggleRecording",
				"key": "ctrl+shift+v",
				"mac": "cmd+shift+v",
				"when": "editorTextFocus"
			},
			{
				"command": "cursorforspeech.openVoicePanel",
				"key": "ctrl+m",
				"mac": "cmd+m",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "cursorforspeech.openVoicePanel",
					"when": "resourceLangId && !editorIsReadonly",
					"group": "navigation@0"
				},
				{
					"command": "cursorforspeech.sendSelectionToChat",
					"when": "editorHasSelection && resourceLangId",
					"group": "navigation@1"
				}
			],
			"editor/context": [
				{
					"command": "cursorforspeech.sendSelectionToChat",
					"when": "editorHasSelection && resourceLangId",
					"group": "navigation@9"
				}
			]
		},
		"configuration": {
			"title": "Cursor for Speech",
			"properties": {
				"cursorforspeech.language": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"english",
						"chinese",
						"german",
						"spanish",
						"russian",
						"korean",
						"french",
						"japanese",
						"portuguese",
